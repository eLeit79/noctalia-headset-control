{
  "id": "headset-control",
  "name": "Headset Control",
  "version": "1.0.0",
  "minNoctaliaVersion": "4.7.0",
  "author": "men",
  "license": "MIT",
  "repository": "https://github.com/eLeit79/noctalia-headset-control",
  "description": "Shows a USB gaming headset in the bar via headsetcontrol, with controls gated on what the device actually supports.",
  "tags": [
    "Bar",
    "System"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml",
    "panel": "Panel.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "pollIntervalSeconds": 60,
      "hideWhenOffline": true,
      "lowThreshold": 20,
      "sidetone": 0,
      "voicePrompts": true,
      "inactiveTime": 0,
      "controlsApplied": false
    }
  }
}
